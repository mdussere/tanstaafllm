#!/bin/sh
# Mike's window in the Wyoh session (Wyoh 6.11): foot, app_id "mike", running
# Mike's client as michael (like Mannie), so its state stays in michael's home.
# The client sets the title "Mike — ready" once it accepts a question; FN+B in
# the Slate waits for it. Look A (6.13): foot-mike.ini (VT323, the series'
# palette) and header.sh (portrait, name, keys) before the client.
here=$(dirname "$(readlink -f "$0")")
# VT323 for the skin (look A, 6.13): installed once for the user running foot
fonts="${XDG_DATA_HOME:-$HOME/.local/share}/fonts"
if [ ! -e "$fonts/vt323_VT323-Regular.ttf" ]; then
    mkdir -p "$fonts" && cp "$here/vt323_VT323-Regular.ttf" "$here/vt323_OFL.txt" "$fonts/" && fc-cache "$fonts" >/dev/null 2>&1
fi
exec foot --config="$here/foot-mike.ini" -a mike -T "Mike — starting" \
    runuser -l michael -c "'$here/header.sh'; export MIKE_HOME=\$HOME/.local/opt/mike; exec python3 \"\$MIKE_HOME/mike.py\""
