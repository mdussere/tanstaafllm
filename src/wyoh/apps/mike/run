#!/bin/sh
# Mike's window in the Wyoh session (Wyoh 6.11): foot, app_id "mike", running
# Mike's client as michael (like Mannie), so its state stays in michael's home.
# The client sets the title "Mike — ready" once it accepts a question; FN+B in
# the Slate waits for it. A first line says how to talk.
exec foot --config=/storage/.local/share/tanstfaafllm/wyoh/deploy/luna/foot.ini \
    -a mike -T "Mike — starting" \
    runuser -l michael -c 'export MIKE_HOME=$HOME/.local/opt/mike
printf "\033[2mL2 dictate · FN+B send · /new forget · /quit\033[0m\n\n"
exec python3 "$MIKE_HOME/smalltalk.py"'
