#!/bin/sh
# Mike's window in the Wyoh session (Wyoh 6.11, look B since 2026-11-03): the
# RPG dialogue window (mike_rpg.py, pygame-ce in /storage/.local/opt/mike-rpg-venv)
# runs as the session user, like foot did, and Mike's client runs as michael in
# its pseudo-terminal, so its state stays in michael's home. Same app_id "mike"
# and the same "Mike — ..." titles as before: FN+B and the Mike <-> Mannie switch
# do not change. Look A (foot) stays available as run-terminal.
here=$(dirname "$(readlink -f "$0")")
venv=/storage/.local/opt/mike-rpg-venv
export MALI_WAYLAND_DMABUF_PROTOCOL=1 SDL_VIDEODRIVER=wayland SDL_VIDEO_WAYLAND_WMCLASS=mike SDL_AUDIODRIVER=dummy
# pygame's own SDL crashes in Luna's libmali (2026-11-03); the system's SDL2
# (sdl2-compat on SDL3, as Luna's games use) works, so it is preloaded.
[ -e /usr/lib/libSDL2-2.0.so.0 ] && export LD_PRELOAD=/usr/lib/libSDL2-2.0.so.0
exec "$venv/bin/python" "$here/mike_rpg.py" -- \
    runuser -l michael -c 'export MIKE_HOME=$HOME/.local/opt/mike MIKE_LANG=en; exec python3 "$MIKE_HOME/mike.py"'
