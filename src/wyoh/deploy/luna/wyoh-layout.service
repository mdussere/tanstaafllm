[Unit]
Description=Wyoh layout policy: at most four tiles per workspace (development)
# User requirement 2026-10-08; see src/wyoh/wyoh_layout.py.
PartOf=wyoh-sway.service
After=wyoh-sway.service
Requires=wyoh-sway.service

[Service]
Type=simple
Environment=HOME=/storage
Environment=XDG_RUNTIME_DIR=/run/wyoh
Environment=LANG=en_US.UTF-8
Environment=XDG_DATA_DIRS=/storage/.local/share/tanstfaafllm/wyoh/deploy/luna/share:/usr/local/share:/usr/share
Environment=PATH=/storage/.local/opt/wyoh-tools/bin:/usr/local/bin:/usr/bin:/usr/sbin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /storage/.local/share/tanstfaafllm/wyoh/wyoh_layout.py -- fuzzel --config /storage/.local/share/tanstfaafllm/wyoh/deploy/luna/fuzzel.ini --dmenu --prompt-only "Too many tiles " --placeholder "4 max: close one (FN+B)" --width 26 --border-color 800000ff --prompt-color 800000ff
Restart=on-failure
RestartSec=2

[Install]
WantedBy=wyoh-sway.service
