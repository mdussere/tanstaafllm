+/* --- Wyoh (Luna): selections ------------------------------------------- */
+
+static bool
+kbd_pressable(struct key *k)
+{
+    return k->type != Pad && k->type != EndRow && k->type != Last && k->w > 0;
+}
+
+/* The key whose centre is nearest to (x, y). */
+static struct key *
+kbd_nearest_key(struct kbd *kb, uint32_t x, uint32_t y)
+{
+    struct key *best = NULL;
+    double best_d = 0;
+    for (struct key *k = kb->layout->keys; k->type != Last; k++) {
+        if (!kbd_pressable(k))
+            continue;
+        if (x >= k->x && x < k->x + k->w && y >= k->y && y < k->y + k->h)
+            return k;
+        double dx = (double)x - (k->x + k->w / 2.0);
+        double dy = (double)y - (k->y + k->h / 2.0);
+        double d = dx * dx + dy * dy;
+        if (!best || d < best_d) {
+            best = k;
+            best_d = d;
+        }
+    }
+    return best;
+}
+
+static void
+kbd_snap_cursors(struct kbd *kb)
+{
+    if (!kb->cursors || !kb->w || !kb->layout)
+        return;
+    for (int i = 0; i < 2; i++) {
+        if (!kb->cursors_placed) {
+            kb->cursor_x[i] = (uint32_t)(kb->cursor_home[i][0] * kb->w);
+            kb->cursor_y[i] = (uint32_t)(kb->cursor_home[i][1] * kb->h);
+        }
+        struct key *k = kbd_nearest_key(kb, kb->cursor_x[i], kb->cursor_y[i]);
+        if (k) {
+            kb->cursor_x[i] = k->x + k->w / 2;
+            kb->cursor_y[i] = k->y + k->h / 2;
+        }
+    }
+    kb->cursors_placed = true;
+}
+
+static void
+kbd_redraw_key(struct kbd *kb, struct key *k)
+{
+    if ((k->type == Mod && kb->mods & k->code) ||
+        (k->type == Compose && kb->compose))
+        kbd_draw_key(kb, k, Press);
+    else
+        kbd_draw_key(kb, k, None);
+}
+
+/* The neighbour of `from` in a direction: same row for left/right; for
+ * up/down, the nearest row that way, then the key closest horizontally. */
+static struct key *
+kbd_neighbour(struct kbd *kb, struct key *from, const char *direction)
+{
+    double cx = from->x + from->w / 2.0, cy = from->y + from->h / 2.0;
+    struct key *best = NULL;
+    double best_row = 0, best_dx = 0;
+    for (struct key *k = kb->layout->keys; k->type != Last; k++) {
+        if (!kbd_pressable(k) || k == from)
+            continue;
+        double kx = k->x + k->w / 2.0, ky = k->y + k->h / 2.0;
+        bool same_row = ky > cy - from->h / 2.0 && ky < cy + from->h / 2.0;
+        if (!strcmp(direction, "left") || !strcmp(direction, "right")) {
+            bool way = !strcmp(direction, "left") ? kx < cx : kx > cx;
+            double dx = kx > cx ? kx - cx : cx - kx;
+            if (same_row && way && (!best || dx < best_dx)) {
+                best = k;
+                best_dx = dx;
+            }
+        } else {
+            bool way = !strcmp(direction, "up") ? ky < cy - from->h / 2.0
+                                                : ky > cy + from->h / 2.0;
+            if (!way)
+                continue;
+            double row = ky > cy ? ky - cy : cy - ky;
+            double dx = kx > cx ? kx - cx : cx - kx;
+            if (!best || row < best_row - 1 ||
+                (row < best_row + 1 && dx < best_dx)) {
+                best = k;
+                best_row = row;
+                best_dx = dx;
+            }
+        }
+    }
+    return best;
+}
+
+/* Commands, one per line: "move <0|1> <up|down|left|right>", "press <0|1>". */
+void
+kbd_cursor_command(struct kbd *kb, const char *line, uint32_t time)
+{
+    char verb[16] = {0}, direction[16] = {0};
+    int which = -1;
+    int n = sscanf(line, "%15s %d %15s", verb, &which, direction);
+    if (!kb->cursors || n < 2 || which < 0 || which > 1 || !kb->w)
+        return;
+    kbd_snap_cursors(kb);
+    struct key *k = kbd_nearest_key(kb, kb->cursor_x[which], kb->cursor_y[which]);
+    if (!k)
+        return;
+    if (!strcmp(verb, "move") && n == 3) {
+        struct key *next = kbd_neighbour(kb, k, direction);
+        if (!next)
+            return;
+        kb->cursor_x[which] = next->x + next->w / 2;
+        kb->cursor_y[which] = next->y + next->h / 2;
+        kbd_redraw_key(kb, k);
+        kbd_redraw_key(kb, next);
+        drwsurf_flip(kb->surf);
+    } else if (!strcmp(verb, "press")) {
+        kbd_press_key(kb, k, time);
+        kbd_release_key(kb, time);
+        /* a layer switch may have moved keys under the selections */
+        kbd_snap_cursors(kb);
+        kbd_draw_layout(kb);
+        drwsurf_flip(kb->surf);
+    }
+}
